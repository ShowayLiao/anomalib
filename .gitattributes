# Makes line endings consistent when using docker on windows
* text=auto eol=lf
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT]} text eol=crlf
# Ignore *ipynb files to detect the language.
# This is because GitHub misdetects the repo language when ipynb files are included.
*.ipynb filter=lfs diff=lfs merge=lfs -text

.github/workflows/*.lock.yml linguist-generated=true merge=ours
*.ipynb !text !filter !merge !diff
*.{png,jpg,jpeg,gif,svg,webp,ico,bmp} binary -text -diff
# Exclude generated output from GitHub language stats
output_limr/** linguist-generated=true
*.ckpt linguist-generated=true
